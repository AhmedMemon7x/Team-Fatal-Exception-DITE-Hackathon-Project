# Live backend integration is enabled by default.
VITE_USE_BACKEND=true
# Leave unset for the local Vite /api proxy.
# VITE_API_URL=https://api.your-campus.example
# Required for student registration only if the API serves multiple campuses.
# VITE_CAMPUS_ID=your-campus-id

# Optional public judge demo access for a deployed frontend. These values are
# compiled into browser JavaScript; use disposable demo accounts only.
# Set these in the frontend host's build environment, not in a committed env file.
# VITE_SHOW_DEMO_ACCOUNTS=true
# VITE_DEMO_STUDENT_EMAIL=student@example.edu
# VITE_DEMO_STUDENT_PASSWORD=replace-with-demo-password
# VITE_DEMO_ADMIN_EMAIL=admin@example.edu
# VITE_DEMO_ADMIN_PASSWORD=replace-with-demo-password
# VITE_DEMO_IT_EMAIL=support@example.edu
# VITE_DEMO_IT_PASSWORD=replace-with-demo-password
# VITE_DEMO_MANAGER_EMAIL=manager@example.edu
# VITE_DEMO_MANAGER_PASSWORD=replace-with-demo-password
