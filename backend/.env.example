ENVIRONMENT=development
DATABASE_URL=sqlite:///./campus.db
SECRET_KEY=development-only-change-this-secret-key-before-deploying
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
MEASUREMENT_BASE_URL=http://localhost:8001/measure
CAMPUS_TIMEZONE=Asia/Karachi
ACCESS_MINUTES=30
REFRESH_DAYS=7
TEST_SESSION_MINUTES=10
MAX_DOWNLOAD_BYTES=8388608
MAX_UPLOAD_BYTES=8388608
MAX_SESSION_BYTES=67108864
MAX_CONCURRENT_TRANSFERS=8
WORKER_INTERVAL_SECONDS=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=15
# Production: ENVIRONMENT=production, random SECRET_KEY, real HTTPS measurement URL
# DATABASE_URL=postgresql+psycopg://campus:your-password@localhost:5432/campus
# Docker Compose also needs POSTGRES_PASSWORD=your-random-database-password
