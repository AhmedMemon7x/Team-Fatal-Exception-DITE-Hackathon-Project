# Copy to .env.deployment.local for a local deployment-mode build, or set these
# in the frontend host's build environment (Netlify, Railway, etc.).
VITE_USE_BACKEND=true
VITE_API_URL=https://your-backend.up.railway.app

# These demo credentials are public in the built JavaScript. Use disposable
# judge-only accounts and create them in the backend before building.
VITE_SHOW_DEMO_ACCOUNTS=true
VITE_DEMO_STUDENT_EMAIL=student@example.edu
VITE_DEMO_STUDENT_PASSWORD=replace-with-demo-password
VITE_DEMO_ADMIN_EMAIL=admin@example.edu
VITE_DEMO_ADMIN_PASSWORD=replace-with-demo-password
VITE_DEMO_IT_EMAIL=support@example.edu
VITE_DEMO_IT_PASSWORD=replace-with-demo-password
VITE_DEMO_MANAGER_EMAIL=manager@example.edu
VITE_DEMO_MANAGER_PASSWORD=replace-with-demo-password
